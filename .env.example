# ── Core ────────────────────────────────────────────────────────────────
# Used to sign login sessions AND to encrypt stored tokens at rest.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later invalidates all sessions and makes stored tokens unreadable.
SECRET_KEY=change-me-to-a-long-random-string

# PostgreSQL connection (async driver).
DATABASE_URL=postgresql+asyncpg://radar:radar@localhost:5432/radar

# ── Polling / schedule ──────────────────────────────────────────────────
POLL_INTERVAL_MINUTES=30
# Time of day (24h, in TIMEZONE) to send the daily summary email.
SUMMARY_HOUR=8
SUMMARY_MINUTE=0
TIMEZONE=Europe/Istanbul

# Applied to any GitHub repo that has no token of its own. STRONGLY recommended:
# unauthenticated GitHub allows only 60 requests/hour per IP, a token allows 5,000.
# Create a fine-grained PAT (read-only, public repos) at github.com/settings/tokens.
DEFAULT_GITHUB_TOKEN=

# Safety valves for very large repo counts. 0 = no cap (poll everything each sweep).
# When capped, least-recently-polled repos go first, rotating fairly across sweeps.
MAX_REPOS_PER_SWEEP=0
# Seconds to wait between requests, to avoid secondary rate limits on big batches.
REQUEST_DELAY_SECONDS=0

# ── Daily summary email (SMTP) ──────────────────────────────────────────
# Leave SMTP_HOST empty to disable email entirely.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=release-radar@releasetracker.me
# Comma-separated recipient list for the daily digest.
SMTP_RECIPIENTS=you@releasetracker.me

# ── Web server ──────────────────────────────────────────────────────────
# Set to true only when served over HTTPS (marks the session cookie Secure).
SESSION_HTTPS_ONLY=false
