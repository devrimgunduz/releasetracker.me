[Unit]
Description=Release Radar — web UI
After=network.target postgresql-18.service
Wants=postgresql-18.service

[Service]
Type=simple
User=radar
Group=radar
WorkingDirectory=/opt/releaseradar
EnvironmentFile=/opt/releaseradar/.env
# One worker keeps things simple. Scale with more workers if needed — the
# scheduler lives in the separate worker service, so extra web workers are safe.
ExecStart=/opt/releaseradar/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=3

# ── Sandboxing (defence in depth) ───────────────────────────────────────
# State lives in PostgreSQL and logs go to the journal, so the process needs
# no write access outside its own tree. ReadWritePaths keeps __pycache__ etc.
# writable while the rest of the filesystem is read-only.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/releaseradar
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
