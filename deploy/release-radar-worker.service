[Unit]
Description=Release Radar — poller & daily summary worker
After=network.target postgresql-18.service
Wants=postgresql-18.service

[Service]
Type=simple
User=radar
Group=radar
WorkingDirectory=/opt/releaseradar
EnvironmentFile=/opt/releaseradar/.env
# Exactly one instance of this service should run, ever. It owns the schedule.
ExecStart=/opt/releaseradar/.venv/bin/python -m app.worker
Restart=on-failure
RestartSec=5

# ── Sandboxing (defence in depth) ───────────────────────────────────────
# State lives in PostgreSQL and logs go to the journal, so the process needs
# no write access outside its own tree. ReadWritePaths keeps __pycache__ etc.
# writable while the rest of the filesystem is read-only.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/releaseradar
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
